<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.stillpoint-labs.dev-postgres-autostart — makes sure the shared local Postgres dev
  container comes back on its own after a Docker Desktop restart, crash, or a full container
  removal (e.g. `docker system prune`), with no human running a recovery command.

  Runs zsh/bin/dev-postgres-autostart, which waits (bounded) for the Docker daemon to be
  reachable and then runs `docker compose -p devcontainer -f
  devcontainer/docker-compose.postgres.yml up -d`. That command is idempotent — a no-op if
  the container is already up and healthy — and `-p devcontainer` is what attaches the
  EXISTING named data volume rather than creating a new empty one.

  There is no reliable launchd WatchPaths signal for "the Docker daemon just came up", so this
  agent fires at login (RunAtLoad) and thereafter on a periodic StartInterval; the script's own
  daemon-reachability wait/retry makes each firing cheap and safe when Docker isn't running yet.

  Installed by install.sh (see install_launchd_agents), which symlinks this file into
  ~/Library/LaunchAgents/ and bootstraps it — matches the pattern used by the
  com.stillpoint-labs.claude-tcc-heal agent in this same directory.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stillpoint-labs.dev-postgres-autostart</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/noah/.config/dotfiles/zsh/bin/dev-postgres-autostart</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/Users/noah/Library/Logs/dev-postgres-autostart.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/noah/Library/Logs/dev-postgres-autostart.stderr.log</string>
</dict>
</plist>
